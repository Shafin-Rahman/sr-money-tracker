{
  "name": "sr-money-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Personal Money Manager - Track every taka you own",
  "scripts": {
    "install:all": "cd backend && npm install",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npx serve .",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "db:generate": "cd backend && npm run db:generate",
    "db:push": "cd backend && npm run db:push",
    "db:studio": "cd backend && npm run db:studio",
    "build": "cd backend && npm run build"
  },
  "keywords": ["finance", "money", "tracker", "personal-finance"],
  "license": "MIT"
}
